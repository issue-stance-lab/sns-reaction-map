{
  "claim_verification": {
    "checked_on": "2026-09-19",
    "claims": [
      {
        "claim": "AIによる無断学習は、著作権法上、常に著作権侵害にあたる",
        "finding": "無断で著作物が使われていること自体は事実で、懸念には根拠がある。ただし著作権法は学習のための利用を原則として権利者の許諾が不要な行為と位置づけており、常に著作権侵害にあたるとまでは言えない。享受目的が併存する場合など例外的に問題になりうる、という整理がより正確。",
        "id": "unauthorized_learning_infringement",
        "issue_ids": [
          "ai-copyright-learning-data"
        ],
        "matched_post_count": 2,
        "sources": [
          {
            "name": "文化審議会著作権分科会法制度小委員会「AIと著作権に関する考え方について」（令和6年3月15日）",
            "url": "https://www.bunka.go.jp/seisaku/bunkashingikai/chosakuken/pdf/94037901_01.pdf"
          },
          {
            "name": "e-Gov法令検索 著作権法 第30条の4",
            "url": "https://laws.e-gov.go.jp/law/345AC0000000048"
          }
        ],
        "verdict": "gap"
      },
      {
        "claim": "AI事業者に学習データの出所を開示させる制度は、日本にはまだ存在しない",
        "finding": "法律による開示の義務化はされておらず、その意味では制度が「無い」という感覚は間違っていない。ただし政府はすでに任意の開示の枠組み（プリンシプル・コード）を用意しており、開示を求める仕組み自体が全く存在しないわけではない。",
        "id": "data_disclosure_needed",
        "issue_ids": [
          "ai-copyright-learning-data",
          "ai-copyright-legal-framework"
        ],
        "matched_post_count": 2,
        "sources": [
          {
            "name": "内閣府知的財産戦略推進事務局「生成AIの適切な利活用等に向けた知的財産の保護及び透明性に関するプリンシプル・コード」",
            "url": "https://www.cas.go.jp/jp/seisakukaigi/titeki2/ai_kentoukai/kaisai/pdf/ai_principle_code.pdf"
          }
        ],
        "verdict": "gap"
      },
      {
        "claim": "AI事業者はクリエイターに一切対価を支払わずに学習データを利用している",
        "finding": "法律上、対価の支払いが義務ではないことは事実で、多くの学習で対価が支払われていないという実感は誤りではない。ただし「一切」払われていないとまでは言えず、契約に基づく対価還元の仕組みや事例は資料にも挙げられている。",
